% ================= Colours and boxes =================
\definecolor{accent}{HTML}{0C4A6E}
\definecolor{boxbg}{HTML}{F2F0EA}
\definecolor{newidea}{HTML}{C2410C}
\tcbset{base/.style={enhanced,breakable,colback=boxbg,colframe=accent,boxrule=0pt,leftrule=2.5pt,arc=0pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,before skip=10pt,after skip=10pt,
  fonttitle=\bfseries,coltitle=black,detach title}}
% \begin{thmbox}{Theorem (name)} ... \end{thmbox}   (likewise defnbox, rmkbox, exbox)
\newtcolorbox{thmbox}[1]{base,title={#1},before upper={\textbf{\tcbtitle}.\ \itshape}}
\newtcolorbox{defnbox}[1]{base,title={#1},before upper={\textbf{\tcbtitle}.\ }}
\newtcolorbox{rmkbox}[1]{base,colframe=black!25,title={#1},before upper={\textbf{\tcbtitle}.\ }}
\newtcolorbox{exbox}[1]{base,colframe=black!25,title={#1},before upper={\textbf{\tcbtitle}.\ }}
% proof steps in the case study: \begin{step}{Title} ... \end{step}; stepnew marks a new idea
\newtcolorbox{step}[1]{enhanced,breakable,colback=white,colframe=black!20,boxrule=0.6pt,arc=2pt,
  left=8pt,right=8pt,top=4pt,bottom=4pt,before skip=10pt,after skip=10pt,
  title={#1},coltitle=black,colbacktitle=black!5,fonttitle=\bfseries,toptitle=2pt,bottomtitle=2pt}
\newtcolorbox{stepnew}[1]{enhanced,breakable,colback=newidea!3,colframe=newidea!70,boxrule=0.8pt,arc=2pt,
  left=8pt,right=8pt,top=4pt,bottom=4pt,before skip=10pt,after skip=10pt,
  title={#1},coltitle=black,colbacktitle=newidea!10,fonttitle=\bfseries,toptitle=2pt,bottomtitle=2pt}
% a placeholder for a proof still to be written
\newtcolorbox{proofslot}{enhanced,breakable,colback=white,colframe=black!40,boxrule=0.6pt,arc=2pt,
  borderline={0.6pt}{0pt}{black!40,dashed},frame hidden,fontupper=\itshape\small,before skip=8pt,after skip=12pt}
\newtcolorbox{conceptsbox}{enhanced,breakable,colback=boxbg,colframe=boxbg,arc=2pt,
  title={Concepts used in this case study},coltitle=accent,colbacktitle=boxbg,fonttitle=\bfseries\small}
\newenvironment{byline}{\begin{quote}\small}{\end{quote}}
\newcommand{\routine}{\fcolorbox{black!30}{black!5}{\sffamily\scriptsize\strut routine}\ }
\newcommand{\newidea}{\fcolorbox{newidea!60}{newidea!10}{\sffamily\scriptsize\color{newidea}\strut new idea}\ }
\newcommand{\uses}[1]{\par\smallskip{\small\color{black!70}\textit{Uses:} #1\par}}
\newcommand{\prereqs}[1]{\noindent{\small\color{black!70}\textit{Before reading this:} #1\par}\medskip}
\newcommand{\neededfor}[1]{\par\medskip\noindent{\small\color{black!70}\textit{Needed for:} #1\par}}

% ================= Exercises =================
% Write the hint and the solution inside the exercise:
%
%   \begin{exercise}
%     Statement ...
%     \begin{hint} ... \end{hint}
%     \begin{solution} ... \end{solution}
%   \end{exercise}
%
% The hint and solution are not printed there; they are collected and printed by
% \printhints and \printsolutions (in the appendices), grouped by section.
% Exercises are numbered within sections (Exercise 2.3.1) and labelled x:2.3.1 automatically.
% To print solutions in place instead (e.g. for a handout), use \showsolutionsinline.
\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\newtcolorbox{exercisebox}[1]{enhanced,breakable,colback=white,colframe=accent!45,boxrule=0.6pt,arc=2pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,before skip=8pt,after skip=8pt,
  title={#1},coltitle=black,fonttitle=\bfseries,detach title,before upper={\textbf{\tcbtitle}.\ }}
\makeatletter
\gdef\pde@hints{}\gdef\pde@sols{}\gdef\pde@lastsec{}
\newif\ifpde@inline
\newcommand{\showsolutionsinline}{\pde@inlinetrue}
% append the tokens #2 (without expanding them) to the list macro #1
\newcommand\pde@append[2]{\xdef#1{\unexpanded\expandafter{#1}\unexpanded\expandafter{#2}}}
\newenvironment{exercise}{%
  \refstepcounter{exercise}\xdef\exnum{\theexercise}\label{x:\exnum}%
  \edef\pde@sec{\thesection}%
  \ifx\pde@sec\pde@lastsec\else            % first exercise of this section: start a group in the appendices
    \xdef\pde@lastsec{\pde@sec}%
    \edef\pde@tmp{\noexpand\exheading{\expandafter\unexpanded\expandafter{\pde@sectitle}}{\pde@sec}}%
    \pde@append\pde@hints\pde@tmp \pde@append\pde@sols\pde@tmp
  \fi
  \begin{exercisebox}{Exercise \theexercise}}%
 {\ifpde@inline\else\pde@where\fi\end{exercisebox}}
\newcommand\pde@where{%
  \@ifundefined{r@hint:\exnum}{}{\par\hfill{\footnotesize\color{black!60}%
    Hint on page~\pageref{hint:\exnum}%
    \@ifundefined{r@sol:\exnum}{}{\ \textperiodcentered\ solution on page~\pageref{sol:\exnum}}}}}
\newcommand\pde@collect[3]{% #1 = label prefix, #2 = printed name, #3 = list macro; the body is \BODY
  \ifpde@inline
    \par\medskip\noindent\textbf{#2.}\ \BODY\par
  \else
    \edef\pde@tmp{\noexpand\pde@item{#1}{\exnum}{\expandafter\unexpanded\expandafter{\BODY}}}%
    \pde@append#3\pde@tmp
  \fi}
\NewEnviron{hint}{\pde@collect{hint}{Hint}\pde@hints}
\NewEnviron{solution}{\pde@collect{sol}{Solution}\pde@sols}
\newcommand\pde@item[3]{\par\noindent\hyperref[x:#2]{\textbf{Exercise #2.}}\label{#1:#2}\ #3\par\medskip}
% heading of each group in the appendices: section title and number
\newcommand\exheading[2]{\section*{#1 (\S#2)}}
\newcommand{\printhints}{\pde@hints}
\newcommand{\printsolutions}{\pde@sols}
\makeatother

% ================= Headings and page style =================
\makeatletter
\@ifundefined{chapter}{}{% book/report classes only
  \titleformat{\chapter}[display]{\normalfont\bfseries}{\large\color{accent}\MakeUppercase{\chaptertitlename}\ \thechapter}{4pt}{\LARGE}
  \titlespacing*{\chapter}{0pt}{0pt}{24pt}
  \numberwithin{equation}{chapter}}
\makeatother
\makeatletter
\gdef\pde@sectitle{}
\newcommand\pde@keeptitle[1]{\gdef\pde@sectitle{#1}#1}% remember the current section title for the appendices
\titleformat{\section}{\normalfont\Large\bfseries}{\color{accent}\thesection}{0.8em}{\pde@keeptitle}
\makeatother
\titleformat*{\subsection}{\normalfont\large\bfseries}
